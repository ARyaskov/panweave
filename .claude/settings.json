{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/check-private-data.py\" --hook",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "Checking the commit for device identifiers"
          }
        ]
      }
    ]
  }
}
